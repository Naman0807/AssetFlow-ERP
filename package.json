{
  "name": "assetflow",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:api": "bun run --filter '@assetflow/api' dev",
    "dev:web": "bun run --filter '@assetflow/web' dev",
    "build": "bun run --filter './apps/*' build",
    "lint": "bun run --filter './apps/*' lint"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "pino-pretty": "^13.1.3"
  }
}
