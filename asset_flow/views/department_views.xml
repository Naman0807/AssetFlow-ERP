<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Department Tree View -->
    <record id="view_assetflow_department_tree" model="ir.ui.view">
        <field name="name">assetflow.department.tree</field>
        <field name="model">assetflow.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="department_head_id"/>
                <field name="parent_id"/>
                <field name="employee_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Department Form View -->
    <record id="view_assetflow_department_form" model="ir.ui.view">
        <field name="name">assetflow.department.form</field>
        <field name="model">assetflow.department</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Department Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="department_head_id"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="employee_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Employees" name="employees">
                            <field name="employee_ids" readonly="1"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Department Search View -->
    <record id="view_assetflow_department_search" model="ir.ui.view">
        <field name="name">assetflow.department.search</field>
        <field name="model">assetflow.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="department_head_id"/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_parent" string="Parent Department" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Department Action -->
    <record id="action_assetflow_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">assetflow.department</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_assetflow_department_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first department
            </p>
            <p>
                Departments help organize your assets and employees hierarchically.
            </p>
        </field>
    </record>
</odoo>
