<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Allocation Tree View -->
    <record id="view_assetflow_allocation_tree" model="ir.ui.view">
        <field name="name">assetflow.allocation.tree</field>
        <field name="model">assetflow.allocation</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue == True"
                  decoration-muted="status == 'returned'">
                <field name="is_overdue" invisible="1"/>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="allocation_date"/>
                <field name="expected_return_date"/>
                <field name="actual_return_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-info="status == 'returned'"
                       decoration-warning="status == 'transfer_requested'"/>
            </tree>
        </field>
    </record>

    <!-- Allocation Form View -->
    <record id="view_assetflow_allocation_form" model="ir.ui.view">
        <field name="name">assetflow.allocation.form</field>
        <field name="model">assetflow.allocation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_return_asset" string="Return Asset" 
                            type="object" class="oe_highlight"
                            invisible="status != 'active'"
                            confirm="Confirm asset return?"/>
                    <button name="action_request_transfer" string="Request Transfer" 
                            type="object" class="oe_highlight"
                            invisible="status != 'active'"/>
                    <button name="action_approve_transfer" string="Approve Transfer" 
                            type="object" class="oe_highlight"
                            invisible="status != 'transfer_requested'"
                            groups="asset_flow.group_assetflow_manager"/>
                    <button name="action_create_new_allocation" string="Create New Allocation" 
                            type="object"
                            invisible="status != 'returned'"
                            groups="asset_flow.group_assetflow_manager"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="active,transfer_requested,returned"/>
                </header>
                <sheet>
                    <group>
                        <group string="Allocation Details">
                            <field name="asset_id"/>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Dates">
                            <field name="allocation_date"/>
                            <field name="expected_return_date"/>
                            <field name="actual_return_date"/>
                            <field name="is_overdue"/>
                        </group>
                    </group>
                    <group string="Condition Notes">
                        <field name="condition_notes" nolabel="1" 
                               placeholder="Describe the asset condition..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Allocation Search View -->
    <record id="view_assetflow_allocation_search" model="ir.ui.view">
        <field name="name">assetflow.allocation.search</field>
        <field name="model">assetflow.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <separator/>
                <filter name="filter_active" string="Active Allocations" 
                        domain="[('status', '=', 'active')]"/>
                <filter name="filter_overdue" string="Overdue" 
                        domain="[('is_overdue', '=', True)]"/>
                <filter name="filter_returned" string="Returned" 
                        domain="[('status', '=', 'returned')]"/>
                <filter name="filter_transfer" string="Transfer Requested" 
                        domain="[('status', '=', 'transfer_requested')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_employee" string="Employee" 
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_department" string="Department" 
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_status" string="Status" 
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Allocation Action -->
    <record id="action_assetflow_allocation" model="ir.actions.act_window">
        <field name="name">Allocations</field>
        <field name="res_model">assetflow.allocation</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_assetflow_allocation_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No allocations yet
            </p>
            <p>
                Allocate assets to employees. The system will prevent 
                double-allocation of the same asset.
            </p>
        </field>
    </record>
</odoo>
