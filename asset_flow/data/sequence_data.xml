<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Asset Tag Sequence: AF-0001, AF-0002, etc. -->
        <record id="seq_asset_tag" model="ir.sequence">
            <field name="name">AssetFlow Asset Tag</field>
            <field name="code">assetflow.asset</field>
            <field name="prefix">AF-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Maintenance Request Sequence: MR-0001, MR-0002, etc. -->
        <record id="seq_maintenance_request" model="ir.sequence">
            <field name="name">AssetFlow Maintenance Request</field>
            <field name="code">assetflow.maintenance.request</field>
            <field name="prefix">MR-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Audit Cycle Sequence -->
        <record id="seq_audit_cycle" model="ir.sequence">
            <field name="name">AssetFlow Audit Cycle</field>
            <field name="code">assetflow.audit.cycle</field>
            <field name="prefix">AUD-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
