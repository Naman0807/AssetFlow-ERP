<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Admin/Manager: full access to everything -->
    <record id="rule_allocation_manager_full" model="ir.rule">
        <field name="name">Allocation: Manager full access</field>
        <field name="model_id" ref="model_assetflow_allocation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_manager'))]"/>
    </record>

    <record id="rule_booking_manager_full" model="ir.rule">
        <field name="name">Booking: Manager full access</field>
        <field name="model_id" ref="model_assetflow_booking"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_manager'))]"/>
    </record>

    <record id="rule_maintenance_manager_full" model="ir.rule">
        <field name="name">Maintenance: Manager full access</field>
        <field name="model_id" ref="model_assetflow_maintenance_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_manager'))]"/>
    </record>

    <!-- Department Head: sees own department allocations -->
    <record id="rule_allocation_dept_head" model="ir.rule">
        <field name="name">Allocation: Dept Head sees own department</field>
        <field name="model_id" ref="model_assetflow_allocation"/>
        <field name="domain_force">[
            '|',
            ('department_id', '=', False),
            ('department_id', 'in', [user.employee_ids.department_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_dept_head'))]"/>
    </record>

    <!-- Employee: sees only own allocations -->
    <record id="rule_allocation_employee" model="ir.rule">
        <field name="name">Allocation: Employee sees own</field>
        <field name="model_id" ref="model_assetflow_allocation"/>
        <field name="domain_force">[('employee_id', '=', user.employee_ids.id)]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_employee'))]"/>
    </record>

    <!-- Employee: sees only own bookings -->
    <record id="rule_booking_employee" model="ir.rule">
        <field name="name">Booking: Employee sees own</field>
        <field name="model_id" ref="model_assetflow_booking"/>
        <field name="domain_force">[('employee_id', '=', user.employee_ids.id)]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_employee'))]"/>
    </record>

    <!-- Employee: sees only own maintenance requests -->
    <record id="rule_maintenance_employee" model="ir.rule">
        <field name="name">Maintenance: Employee sees own</field>
        <field name="model_id" ref="model_assetflow_maintenance_request"/>
        <field name="domain_force">[('employee_id', '=', user.employee_ids.id)]</field>
        <field name="groups" eval="[(4, ref('group_assetflow_employee'))]"/>
    </record>
</odoo>
